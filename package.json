{
  "name": "sftp-remote-editor",
  "displayName": "SFTP Remote Editor",
  "description": "Edit files directly on your server over SFTP or FTPS. Browse the server in a side panel, open a file, change it and save: no local copy, no upload step. Uses your existing .vscode/sftp.json.",
  "version": "0.1.1",
  "publisher": "delta-solutions",
  "author": "Delta Solutions",
  "license": "MIT",
  "homepage": "https://www.deltasolutions.be/",
  "repository": {
    "type": "git",
    "url": "https://github.com/dietercoopman/sftp-remote-editor.git"
  },
  "bugs": {
    "url": "https://github.com/dietercoopman/sftp-remote-editor/issues"
  },
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "sftp",
    "ftps",
    "ftp",
    "ssh",
    "remote",
    "edit remote files",
    "remote editor",
    "edit on server",
    "remote host",
    "server",
    "web development"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onFileSystem:sftp-remote"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Connects to the servers defined in the workspace's sftp.json, so it only runs in trusted workspaces."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Reads the server configuration from .vscode/sftp.json on the local file system."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sftpRemoteEditor",
          "title": "SFTP Remote Editor",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "views": {
      "sftpRemoteEditor": [
        {
          "id": "sftpRemoteEditor.servers",
          "name": "Servers",
          "contextualTitle": "SFTP Remote Editor",
          "icon": "$(server)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "sftpRemoteEditor.servers",
        "contents": "No servers found.\nAdd a .vscode/sftp.json to your project to browse and edit its server here.\n[Create sftp.json](command:sftpRemoteEditor.openConfig)"
      }
    ],
    "commands": [
      {
        "command": "sftpRemoteEditor.refresh",
        "title": "Refresh",
        "category": "SFTP Remote",
        "icon": "$(refresh)"
      },
      {
        "command": "sftpRemoteEditor.openConfig",
        "title": "Open sftp.json",
        "category": "SFTP Remote",
        "icon": "$(gear)"
      },
      {
        "command": "sftpRemoteEditor.newFile",
        "title": "New File...",
        "category": "SFTP Remote",
        "icon": "$(new-file)"
      },
      {
        "command": "sftpRemoteEditor.newFolder",
        "title": "New Folder...",
        "category": "SFTP Remote",
        "icon": "$(new-folder)"
      },
      {
        "command": "sftpRemoteEditor.rename",
        "title": "Rename...",
        "category": "SFTP Remote"
      },
      {
        "command": "sftpRemoteEditor.delete",
        "title": "Delete",
        "category": "SFTP Remote"
      },
      {
        "command": "sftpRemoteEditor.download",
        "title": "Download to Project",
        "category": "SFTP Remote"
      },
      {
        "command": "sftpRemoteEditor.compareWithLocal",
        "title": "Compare with Local File",
        "category": "SFTP Remote"
      },
      {
        "command": "sftpRemoteEditor.copyRemotePath",
        "title": "Copy Remote Path",
        "category": "SFTP Remote"
      },
      {
        "command": "sftpRemoteEditor.disconnect",
        "title": "Disconnect",
        "category": "SFTP Remote",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "sftpRemoteEditor.forgetTrustedHostKeys",
        "title": "Forget Trusted Host Keys",
        "category": "SFTP Remote"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "sftpRemoteEditor.newFile",
          "when": "false"
        },
        {
          "command": "sftpRemoteEditor.newFolder",
          "when": "false"
        },
        {
          "command": "sftpRemoteEditor.rename",
          "when": "false"
        },
        {
          "command": "sftpRemoteEditor.delete",
          "when": "false"
        },
        {
          "command": "sftpRemoteEditor.download",
          "when": "false"
        },
        {
          "command": "sftpRemoteEditor.compareWithLocal",
          "when": "false"
        },
        {
          "command": "sftpRemoteEditor.copyRemotePath",
          "when": "false"
        },
        {
          "command": "sftpRemoteEditor.disconnect",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "sftpRemoteEditor.refresh",
          "when": "view == sftpRemoteEditor.servers",
          "group": "navigation@1"
        },
        {
          "command": "sftpRemoteEditor.openConfig",
          "when": "view == sftpRemoteEditor.servers",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "sftpRemoteEditor.newFile",
          "when": "view == sftpRemoteEditor.servers && viewItem =~ /^(server|dir)$/",
          "group": "inline@1"
        },
        {
          "command": "sftpRemoteEditor.newFolder",
          "when": "view == sftpRemoteEditor.servers && viewItem =~ /^(server|dir)$/",
          "group": "inline@2"
        },
        {
          "command": "sftpRemoteEditor.refresh",
          "when": "view == sftpRemoteEditor.servers && viewItem =~ /^(server|dir)$/",
          "group": "inline@3"
        },
        {
          "command": "sftpRemoteEditor.newFile",
          "when": "view == sftpRemoteEditor.servers && viewItem =~ /^(server|dir)$/",
          "group": "1_new@1"
        },
        {
          "command": "sftpRemoteEditor.newFolder",
          "when": "view == sftpRemoteEditor.servers && viewItem =~ /^(server|dir)$/",
          "group": "1_new@2"
        },
        {
          "command": "sftpRemoteEditor.compareWithLocal",
          "when": "view == sftpRemoteEditor.servers && viewItem == file",
          "group": "2_local@1"
        },
        {
          "command": "sftpRemoteEditor.download",
          "when": "view == sftpRemoteEditor.servers && viewItem == file",
          "group": "2_local@2"
        },
        {
          "command": "sftpRemoteEditor.copyRemotePath",
          "when": "view == sftpRemoteEditor.servers && viewItem =~ /^(server|dir|file)$/",
          "group": "3_copy@1"
        },
        {
          "command": "sftpRemoteEditor.rename",
          "when": "view == sftpRemoteEditor.servers && viewItem =~ /^(dir|file)$/",
          "group": "4_modify@1"
        },
        {
          "command": "sftpRemoteEditor.delete",
          "when": "view == sftpRemoteEditor.servers && viewItem =~ /^(dir|file)$/",
          "group": "4_modify@2"
        },
        {
          "command": "sftpRemoteEditor.refresh",
          "when": "view == sftpRemoteEditor.servers && viewItem =~ /^(server|dir)$/",
          "group": "5_view@1"
        },
        {
          "command": "sftpRemoteEditor.disconnect",
          "when": "view == sftpRemoteEditor.servers && viewItem == server",
          "group": "5_view@2"
        }
      ]
    },
    "configuration": {
      "title": "SFTP Remote Editor",
      "properties": {
        "sftpRemoteEditor.configFile": {
          "type": "string",
          "default": ".vscode/sftp.json",
          "description": "Path (relative to the workspace folder, and inside it) to the SFTP config. Defaults to the same file used by Git SFTP Upload and the SFTP extension by Natizyskunk."
        },
        "sftpRemoteEditor.idleDisconnectMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "description": "Close a server connection after this many minutes without activity. It reconnects automatically when needed. 0 keeps connections open."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./ --noEmit && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package",
    "publish": "npm run publish:marketplace && npm run publish:ovsx",
    "publish:marketplace": "vsce publish",
    "publish:ovsx": "vsce package && ovsx publish sftp-remote-editor-$npm_package_version.vsix"
  },
  "dependencies": {
    "basic-ftp": "^5.3.1",
    "jsonc-parser": "^3.3.1",
    "ssh2-sftp-client": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ssh2-sftp-client": "^9.0.4",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "ovsx": "^1.3.0",
    "typescript": "^5.6.0"
  }
}
